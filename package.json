{
  "name": "musicweb-sync-console",
  "version": "1.0.0",
  "private": true,
  "description": "Local multi-device music playback console.",
  "license": "MIT",
  "scripts": {
    "start": "node launcher.js",
    "build": "pkg launcher.js --target node20-win-x64 --output musicweb.exe --compress GZip"
  },
  "engines": {
    "node": ">=18"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node20-win-x64"
    ]
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.12.0"
  }
}
